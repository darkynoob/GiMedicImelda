generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

/// Estado general del tenant/cliente del sistema.
enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Estado del usuario.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

/// Tipo de establecimiento o sede.
enum FacilityType {
  HOSPITAL
  CLINIC
  CONSULTING_ROOM
  LABORATORY
  IMAGING_CENTER
  OTHER
}

/// Categoría funcional de especialidad médica.
enum SpecialtyCategory {
  BASIC
  CLINICAL
  SURGICAL
  DIAGNOSTIC_SUPPORT
  COMPLEMENTARY
}

/// Estado del expediente clínico.
enum MedicalRecordStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

/// Tipo de episodio de atención.
enum EncounterType {
  OUTPATIENT
  EMERGENCY
  HOSPITALIZATION
  SURGERY
  FOLLOW_UP
}

/// Estado del episodio.
enum EncounterStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Estado operativo/legal de un registro puntual del episodio.
enum EncounterRecordStatus {
  DRAFT
  OPEN
  CLOSED
  SIGNED
}

/// Categoría funcional del documento.
/// Esto NO es la especialidad.
/// La especialidad va en Specialty.
enum DocumentCategory {
  CONSULTATION
  EMERGENCY
  HOSPITALIZATION
  SURGERY
  NURSING
  DIAGNOSTIC
  LEGAL
  DISCHARGE
  DEATH
  ADMINISTRATIVE
  OTHER
}

/// Estado documental.
enum DocumentStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SIGNED
  AMENDED
  SUPERSEDED
  VOID_ADMIN
}

/// Tipo de firma aplicada.
enum SignatureType {
  SIMPLE_ELECTRONIC
  ADVANCED_ELECTRONIC
  DIGITAL
}

/// Acción auditada.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  EXPORT
  PRINT
  SIGN
  LOGIN
  LOGOUT
  ACCESS_DENIED
}

/// Origen del ingreso.
enum AdmissionSource {
  CONSULTATION
  EMERGENCY
  TRANSFER
  SURGERY
  OTHER
}

/// Tipo de egreso.
enum DischargeType {
  NORMAL
  VOLUNTARY
  TRANSFER
  DEFUNCTION
  OTHER
}

/// Sexo biológico al nacer.
enum SexAtBirth {
  MALE
  FEMALE
  INTERSEX
  UNKNOWN
}

//////////////////////////////////////////////////////
// CORE MULTI-TENANT
//////////////////////////////////////////////////////

/// Cliente dueño del sistema.
/// Ejemplo:
/// - un hospital privado
/// - una cadena de clínicas
/// - un grupo médico
model Tenant {
  /// ID único del tenant.
  id String @id @default(uuid())

  /// Código único del tenant.
  code String @unique

  /// Nombre comercial del tenant.
  name String

  /// Razón social.
  legalName String?

  /// RFC o identificador fiscal.
  taxId String?

  /// Zona horaria principal.
  timezone String @default("America/Mexico_City")

  /// Estado del tenant.
  status TenantStatus @default(ACTIVE)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de última actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  specialties                Specialty[]
  facilities                 Facility[]
  users                      User[]
  patients                   Patient[]
  patientIdentifiers         PatientIdentifier[]
  medicalRecords             MedicalRecord[]
  encounters                 Encounter[]
  documentTypes              DocumentType[]
  clinicalDocuments          ClinicalDocument[]
  serviceAreas               ServiceArea[]
  vitalSigns                 VitalSign[]
  diagnoses                  Diagnosis[]
  problems                   Problem[]
  allergies                  Allergy[]
  medicationStatements       MedicationStatement[]
  procedureRecords           ProcedureRecord[]
  labRequests                LabRequest[]
  labResults                 LabResult[]
  imagingRequests            ImagingRequest[]
  imagingReports             ImagingReport[]
  nursingNotes               NursingNote[]
  consentForms               ConsentForm[]
  discharges                 Discharge[]
  mpNotifications            MpNotification[]
  deathRecords               DeathRecord[]
  attachments                Attachment[]
  auditLogs                  AuditLog[]
  patientResponsibleContacts PatientResponsibleContact[]
  patientCoverages           PatientCoverage[]
  patientDocuments           PatientDocument[]
  patientDemographicProfiles PatientDemographicProfile[]
  patientClinicalProfiles    PatientClinicalProfile[]
  patientBillingProfiles     PatientBillingProfile[]
  encounterProfiles          EncounterProfile[]
  encounterSectionRecords    EncounterSectionRecord[]
  emergencyEvolutions        EmergencyEvolution[]
  emergencyOrderSets         EmergencyOrderSet[]
  emergencyOrderMedications  EmergencyOrderMedication[]
  emergencyOrderSolutions    EmergencyOrderIntravenousSolution[]
  emergencyOrderStudies      EmergencyOrderRequestedStudy[]
  emergencyOrderTraces       EmergencyOrderTrace[]
  emergencyOrderTransfusions EmergencyOrderTransfusion[]
  emergencyDischarges        EmergencyDischarge[]
  emergencyDocuments         EmergencyDocument[]
  emergencyConsultations     EmergencyConsultation[]
  hospitalAdmissions         HospitalAdmission[]
  hospitalEvolutions         HospitalEvolution[]
  hospitalEvolutionResults   HospitalEvolutionResult[]
  hospitalEvolutionDiagnoses HospitalEvolutionDiagnosis[]
  hospitalMedicalOrders      HospitalMedicalOrder[]
  hospitalOrderMedications   HospitalOrderMedication[]
  hospitalOrderSolutions     HospitalOrderIntravenousSolution[]
  hospitalOrderStudies       HospitalOrderRequestedStudy[]
  hospitalOrderConsultations HospitalOrderConsultationRequest[]
  hospitalOrderTraces        HospitalOrderTrace[]
  hospitalConsultations      HospitalConsultation[]
  hospitalSurgicalDocuments  HospitalSurgicalDocument[]
  hospitalNursingShifts      HospitalNursingShift[]
  hospitalNursingVitals      HospitalNursingVitalSign[]
  hospitalMedicationAdministrations HospitalMedicationAdministration[]
  hospitalNursingProcedures  HospitalNursingProcedure[]
  hospitalDischarges         HospitalDischarge[]
  hospitalDocuments          HospitalDocument[]
  hospitalDocumentLabStudies HospitalDocumentLabStudy[]
  hospitalDocumentImagingStudies HospitalDocumentImagingStudy[]
  hospitalDocumentSigners    HospitalDocumentSigner[]
}

/// Catálogo de especialidades clínicas.
/// Aquí entran ONCO, GASTRO, CARDIO, PEDI, GINE, etc.
model Specialty {
  /// ID único de la especialidad.
  id String @id @default(uuid())

  /// Tenant dueño del catálogo.
  tenantId String

  /// Código corto único.
  /// Ejemplo: ONCO, GASTRO, CARDIO.
  code String

  /// Nombre visible de la especialidad.
  /// Ejemplo: Oncología, Gastroenterología.
  name String

  /// Categoría clínica/operativa de la especialidad.
  category SpecialtyCategory @default(CLINICAL)

  /// Descripción opcional.
  description String?

  /// Activa o inactiva.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  serviceAreas      ServiceArea[]
  encounters        Encounter[]
  documentTypes     DocumentType[]
  clinicalDocuments ClinicalDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([name])
}

/// Sede física del tenant.
/// Ejemplo:
/// - Hospital Central
/// - Clínica Roma
/// - Consultorio 2
model Facility {
  /// ID único de la sede.
  id String @id @default(uuid())

  /// Tenant dueño de la sede.
  tenantId String

  /// Código único dentro del tenant.
  code String

  /// Nombre visible de la sede.
  name String

  /// Razón social de la sede.
  legalName String?

  /// Tipo de establecimiento.
  facilityType FacilityType

  /// Nombre de institución, si aplica.
  institutionName String?

  /// Propietario o responsable.
  ownerName String?

  /// Dirección principal.
  addressLine1 String

  /// Complemento de dirección.
  addressLine2 String?

  /// Ciudad.
  city String?

  /// Estado.
  state String?

  /// Código postal.
  postalCode String?

  /// País.
  country String @default("MX")

  /// Teléfono principal.
  phone String?

  /// Correo principal.
  email String?

  /// Bandera de activación.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceAreas      ServiceArea[]
  users             User[]
  medicalRecords    MedicalRecord[]
  encounters        Encounter[]
  clinicalDocuments ClinicalDocument[]
  consentForms      ConsentForm[]
  auditLogs         AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Área funcional de una sede.
/// Ejemplo:
/// - Urgencias
/// - Hospitalización
/// - Consulta externa
/// - Quirófano
model ServiceArea {
  /// ID único del área.
  id String @id @default(uuid())

  /// Tenant dueño del área.
  tenantId String

  /// Sede donde existe el área.
  facilityId String

  /// Especialidad predominante del área, si aplica.
  /// Ejemplo: Oncología, Gastro.
  specialtyId String?

  /// Código único del área dentro de la sede.
  code String

  /// Nombre del área.
  name String

  /// Descripción opcional.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  specialty  Specialty?  @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  encounters Encounter[]

  @@unique([facilityId, code])
  @@index([tenantId])
  @@index([facilityId])
  @@index([specialtyId])
}

//////////////////////////////////////////////////////
// AUTH / ACCESS CONTROL
//////////////////////////////////////////////////////

/// Usuario autenticable del sistema.
/// Puede ser médico, enfermería, recepción, admin, etc.
model User {
  /// ID único del usuario.
  id String @id @default(uuid())

  /// Tenant al que pertenece.
  tenantId String

  /// Sede principal asociada.
  facilityId String?

  /// Especialidad principal del usuario.
  /// Ejemplo: un gastroenterólogo o un oncólogo.
  specialtyId String?

  /// Correo para login.
  email String

  /// Hash de contraseña.
  passwordHash String

  /// Nombre.
  firstName String

  /// Primer apellido.
  lastName String

  /// Segundo apellido.
  middleName String?

  /// Nombre completo precalculado.
  fullName String

  /// Cédula profesional o licencia.
  professionalLicense String?

  /// Estado del usuario.
  status UserStatus @default(ACTIVE)

  /// Último login.
  lastLoginAt DateTime?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility             Facility?               @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  specialty            Specialty?              @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  roles                UserRole[]
  authoredDocuments    ClinicalDocument[]      @relation("DocumentAuthor")
  documentVersions     DocumentVersion[]
  documentSignatures   DocumentSignature[]
  statusHistoryChanges DocumentStatusHistory[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  imagingRequests      ImagingRequest[]
  nursingNotes         NursingNote[]
  uploadedAttachments  Attachment[]
  auditLogs            AuditLog[]
  authoredEncounterSectionRecords EncounterSectionRecord[]
  signedEmergencyEvolutions EmergencyEvolution[] @relation("EmergencyEvolutionSigner")
  signedEmergencyOrderSets EmergencyOrderSet[] @relation("EmergencyOrderSetSigner")
  signedEmergencyDischarges EmergencyDischarge[] @relation("EmergencyDischargeSigner")
  signedEmergencyDocuments EmergencyDocument[] @relation("EmergencyDocumentSigner")
  signedHospitalAdmissions HospitalAdmission[] @relation("HospitalAdmissionSigner")
  signedHospitalEvolutions HospitalEvolution[] @relation("HospitalEvolutionSigner")
  signedHospitalMedicalOrders HospitalMedicalOrder[] @relation("HospitalMedicalOrderSigner")
  signedHospitalSurgicalDocuments HospitalSurgicalDocument[] @relation("HospitalSurgicalDocumentSigner")
  signedHospitalNursingShifts HospitalNursingShift[] @relation("HospitalNursingShiftSigner")
  signedHospitalDischarges HospitalDischarge[] @relation("HospitalDischargeSigner")
  signedHospitalDocuments HospitalDocument[] @relation("HospitalDocumentSigner")
  requestedHospitalConsultations HospitalConsultation[] @relation("HospitalConsultationRequester")
  respondingHospitalConsultations HospitalConsultation[] @relation("HospitalConsultationResponder")
  requestedEmergencyConsultations EmergencyConsultation[] @relation("EmergencyConsultationRequester")
  respondingEmergencyConsultations EmergencyConsultation[] @relation("EmergencyConsultationResponder")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([facilityId])
  @@index([specialtyId])
}

/// Rol del sistema.
/// Ejemplo:
/// - PHYSICIAN
/// - NURSE
/// - TENANT_ADMIN
model Role {
  /// ID del rol.
  id String @id @default(uuid())

  /// Código único.
  code String @unique

  /// Nombre visible.
  name String

  /// Descripción.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  permissions RolePermission[]
  users       UserRole[]
}

/// Permiso atómico.
/// Ejemplo:
/// - patients.read
/// - documents.sign
/// - audits.read
model Permission {
  /// ID del permiso.
  id String @id @default(uuid())

  /// Código único del permiso.
  code String @unique

  /// Nombre visible.
  name String

  /// Descripción funcional.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  roles RolePermission[]
}

/// Tabla pivote usuario-rol.
model UserRole {
  /// ID del vínculo.
  id String @id @default(uuid())

  /// Usuario.
  userId String

  /// Rol.
  roleId String

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// Tabla pivote rol-permiso.
model RolePermission {
  /// ID del vínculo.
  id String @id @default(uuid())

  /// Rol.
  roleId String

  /// Permiso.
  permissionId String

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

//////////////////////////////////////////////////////
// PATIENTS
//////////////////////////////////////////////////////

/// Paciente del sistema.
/// Pertenece al tenant y puede tener expediente en una o varias sedes.
model Patient {
  /// ID único del paciente.
  id String @id @default(uuid())

  /// Tenant dueño del paciente.
  tenantId String

  /// Código externo o legado.
  externalCode String?

  /// Nombre.
  firstName String

  /// Primer apellido.
  lastName String

  /// Segundo apellido.
  middleName String?

  /// Nombre completo precalculado.
  fullName String

  /// Sexo biológico al nacer.
  sexAtBirth SexAtBirth

  /// Fecha de nacimiento.
  birthDate DateTime? @db.Date

  /// Edad snapshot, útil cuando fue capturada textualmente.
  ageSnapshot Int?

  /// Estado civil.
  maritalStatus String?

  /// Tipo sanguíneo.
  bloodType String?

  /// CURP.
  curp String?

  /// RFC del paciente o de la persona física titular del perfil.
  rfc String?

  /// Teléfono.
  phone String?

  /// Teléfono alterno.
  alternatePhone String?

  /// Correo.
  email String?

  /// Dirección línea 1.
  addressLine1 String?

  /// Dirección línea 2.
  addressLine2 String?

  /// Ciudad.
  city String?

  /// Estado.
  state String?

  /// Código postal.
  postalCode String?

  /// País.
  country String? @default("MX")

  /// Municipio o alcaldía.
  municipality String?

  /// Colonia.
  neighborhood String?

  /// Calle.
  street String?

  /// Número exterior.
  exteriorNumber String?

  /// Número interior.
  interiorNumber String?

  /// Contacto de emergencia.
  emergencyContactName String?

  /// Teléfono de emergencia.
  emergencyContactPhone String?

  /// Relación con el contacto de emergencia.
  emergencyContactRelation String?

  /// Estatus administrativo del paciente.
  patientStatus String @default("Activo")

  /// Tipo operativo del paciente.
  patientType String?

  /// Unidad médica de referencia capturada en admisión.
  medicalUnit String?

  /// Señala si se confirmaron alergias conocidas al alta.
  hasKnownAllergies Boolean?

  /// Resumen administrativo de alergias conocidas.
  allergiesNotes String?

  /// Ocupación referida.
  occupation String?

  /// Escolaridad referida.
  educationLevel String?

  /// Religión referida.
  religion String?

  /// Lengua principal del paciente.
  primaryLanguage String?

  /// Si requiere traductor para la atención.
  requiresTranslator Boolean?

  /// Origen o canal del registro.
  registrationSource String?

  /// Observaciones administrativas del alta.
  administrativeNotes String?

  /// Activo/inactivo lógico.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifiers          PatientIdentifier[]
  medicalRecords       MedicalRecord[]
  encounters           Encounter[]
  vitalSigns           VitalSign[]
  diagnoses            Diagnosis[]
  problems             Problem[]
  allergies            Allergy[]
  medicationStatements MedicationStatement[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  labResults           LabResult[]
  imagingRequests      ImagingRequest[]
  imagingReports       ImagingReport[]
  nursingNotes         NursingNote[]
  consentForms         ConsentForm[]
  discharges           Discharge[]
  mpNotifications      MpNotification[]
  deathRecords         DeathRecord[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
  clinicalDocuments    ClinicalDocument[]
  responsibleContact   PatientResponsibleContact?
  coverages            PatientCoverage[]
  documents            PatientDocument[]
  demographicProfile   PatientDemographicProfile?
  clinicalProfile      PatientClinicalProfile?
  billingProfile       PatientBillingProfile?
  encounterSectionRecords EncounterSectionRecord[]
  emergencyEvolutions EmergencyEvolution[]
  emergencyOrderSets EmergencyOrderSet[]
  emergencyDischarges EmergencyDischarge[]
  emergencyDocuments EmergencyDocument[]
  emergencyConsultations EmergencyConsultation[]
  hospitalAdmissions HospitalAdmission[]
  hospitalEvolutions HospitalEvolution[]
  hospitalEvolutionResults HospitalEvolutionResult[]
  hospitalEvolutionDiagnoses HospitalEvolutionDiagnosis[]
  hospitalMedicalOrders HospitalMedicalOrder[]
  hospitalOrderMedications HospitalOrderMedication[]
  hospitalOrderSolutions HospitalOrderIntravenousSolution[]
  hospitalOrderStudies HospitalOrderRequestedStudy[]
  hospitalOrderConsultations HospitalOrderConsultationRequest[]
  hospitalOrderTraces HospitalOrderTrace[]
  hospitalConsultations HospitalConsultation[]
  hospitalSurgicalDocuments HospitalSurgicalDocument[]
  hospitalNursingShifts HospitalNursingShift[]
  hospitalNursingVitals HospitalNursingVitalSign[]
  hospitalMedicationAdministrations HospitalMedicationAdministration[]
  hospitalNursingProcedures HospitalNursingProcedure[]
  hospitalDischarges HospitalDischarge[]
  hospitalDocuments HospitalDocument[]
  hospitalDocumentLabStudies HospitalDocumentLabStudy[]
  hospitalDocumentImagingStudies HospitalDocumentImagingStudy[]
  hospitalDocumentSigners HospitalDocumentSigner[]

  @@index([tenantId])
  @@index([fullName])
  @@index([curp])
  @@index([rfc])
  @@index([phone])
  @@index([externalCode])
}

/// Identificadores alternos del paciente.
/// Ejemplo:
/// - NSS
/// - póliza
/// - número legado
model PatientIdentifier {
  /// ID del identificador.
  id String @id @default(uuid())

  /// Tenant dueño del registro.
  tenantId String

  /// Paciente dueño del identificador.
  patientId String

  /// Tipo de identificador.
  identifierType String

  /// Valor del identificador.
  identifierValue String

  /// Indica si es principal.
  isPrimary Boolean @default(false)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, identifierType, identifierValue])
  @@index([tenantId])
  @@index([patientId])
}

/// Responsable principal del paciente a nivel administrativo.
/// Se mantiene separado para no sobrecargar el registro base del paciente y
/// poder evolucionar la gestión de responsables sin tocar el flujo de alta.
model PatientResponsibleContact {
  id String @id @default(uuid())

  tenantId String

  patientId String @unique

  fullName String

  relationship String?

  phone String

  alternatePhone String?

  email String?

  legalRepresentationType String?

  addressLine1 String?

  addressLine2 String?

  city String?

  state String?

  postalCode String?

  country String? @default("MX")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
}

/// Cobertura financiera del paciente.
/// Se permite más de una para soportar escenarios con pagador principal,
/// secundario o cambios históricos sin rediseñar la tabla.
model PatientCoverage {
  id String @id @default(uuid())

  tenantId String

  patientId String

  coverageType String

  providerName String

  planName String?

  policyNumber String?

  membershipNumber String?

  insuredPersonName String?

  relationshipToInsured String?

  validFrom DateTime? @db.Date

  validUntil DateTime? @db.Date

  authorizationNotes String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([patientId, isPrimary])
}

/// Documentos administrativos del paciente.
/// No sustituye archivos adjuntos: aquí vive el metadato estructurado del
/// documento (tipo, folio, vigencia) para edición rápida.
model PatientDocument {
  id String @id @default(uuid())

  tenantId String

  patientId String

  documentType String

  documentNumber String

  issuedBy String?

  issuedAt DateTime? @db.Date

  expiresAt DateTime? @db.Date

  isPrimary Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([patientId, isPrimary])
}

/// Demografía ampliada para el perfil del paciente.
/// Son datos no críticos para abrir el expediente, por lo que viven fuera de
/// Patient y pueden crecer sin afectar el flujo de registro rápido.
model PatientDemographicProfile {
  id String @id @default(uuid())

  tenantId String

  patientId String @unique

  preferredName String?

  genderIdentity String?

  preferredPronouns String?

  nationality String?

  countryOfBirth String?

  stateOfBirth String?

  ethnicGroup String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
}

/// Perfil clínico administrativo del paciente.
/// Complementa el catálogo clínico transaccional (alergias, problemas,
/// medicamentos) con banderas y resúmenes útiles en la portada del perfil.
model PatientClinicalProfile {
  id String @id @default(uuid())

  tenantId String

  patientId String @unique

  organDonorStatus String?

  rhFactor String?

  pregnancyStatus String?

  disabilityNotes String?

  clinicalAlerts String?

  clinicalObservations String?

  chronicConditionsNotes String?

