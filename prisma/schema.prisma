//////////////////////////////////////////////////////
// FILES / ATTACHMENTS
//////////////////////////////////////////////////////

/// Archivo adjunto.
/// Puede ligarse a documento, paciente y/o episodio.
model Attachment {
  /// ID del archivo.
  id String @id @default(uuid())

  /// Tenant dueño del archivo.
  tenantId String

  /// Documento relacionado, si aplica.
  documentId String?

  /// Paciente relacionado, si aplica.
  patientId String?

  /// Episodio relacionado, si aplica.
  encounterId String?

  /// Nombre original del archivo.
  fileName String

  /// Tipo MIME.
  mimeType String

  /// Llave o ruta en almacenamiento externo.
  storageKey String

  /// Tamaño en bytes.
  fileSizeBytes BigInt

  /// Usuario que subió el archivo.
  uploadedByUserId String?

  /// Fecha/hora de carga.
  uploadedAt DateTime @default(now())

  /// Metadatos opcionales.
  metadataJson Json?

  /// Relaciones.
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document       ClinicalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  patient        Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter      Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  uploadedByUser User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([documentId])
  @@index([patientId])
  @@index([encounterId])
  @@index([uploadedByUserId])
}

//////////////////////////////////////////////////////
// AUDIT
//////////////////////////////////////////////////////

/// Bitácora de auditoría.
/// Guarda accesos, lecturas, cambios, firmas, exportaciones, etc.
model AuditLog {
  /// ID del evento.
  id String @id @default(uuid())

  /// Tenant dueño del evento.
  tenantId String

  /// Usuario que ejecutó la acción.
  userId String?

  /// Acción auditada.
  action AuditAction

  /// Tipo de entidad afectada.
  /// Ejemplo: Patient, ClinicalDocument, Encounter.
  entityType String

  /// ID de la entidad afectada.
  entityId String?

  /// Sede relacionada.
  facilityId String?

  /// Paciente relacionado.
  patientId String?

  /// Episodio relacionado.
  encounterId String?

  /// Datos extra.
  metadataJson Json?

  /// Dirección IP.
  ipAddress String?

  /// User-Agent.
  userAgent String?

  /// Fecha/hora del evento.
  createdAt DateTime @default(now())

  /// Relaciones.
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  facility  Facility?  @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient   Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
