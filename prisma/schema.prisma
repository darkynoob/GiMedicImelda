/// Perfil estructurado complementario del episodio.
/// Permite capturar secciones variables por tipo sin rigidizar el modelo base.
model EncounterProfile {
  /// ID único del perfil.
  id String @id @default(uuid())

  /// Tenant dueño del perfil.
  tenantId String

  /// Episodio asociado.
  encounterId String @unique

  /// Tipo de episodio al momento de captura.
  encounterType EncounterType

  /// Secciones dinámicas estructuradas por pestaña/formato.
  sectionsJson Json

  /// Alertas o banderas derivadas de la captura.
  alertsJson Json?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([encounterType])
}

/// Registro flexible ligado a una pestaña o subsección del episodio.
/// Permite capturar múltiples notas, borradores y variantes por tipo de episodio.
model EncounterSectionRecord {
  /// ID único del registro.
  id String @id @default(uuid())

  /// Tenant dueño del registro.
  tenantId String

  /// Episodio relacionado.
  encounterId String

  /// Paciente relacionado.
  patientId String

  /// Tipo de episodio al crear el registro.
  encounterType EncounterType

  /// Pestaña funcional del episodio.
  tabKey String

  /// Tipo de nota o documento dentro de la pestaña.
  noteType String

  /// Título visible del registro.
  title String

  /// Estado operativo/legal del registro.
  status EncounterRecordStatus @default(DRAFT)

  /// Fecha/hora clínica del registro.
  recordedAt DateTime @default(now())

  /// Usuario autor principal.
  authoredByUserId String?

  /// Carga estructurada editable del formulario.
  formDataJson Json

  /// Metadatos auxiliares para UI, auditoría ligera o relaciones futuras.
  metadataJson Json?

  /// Fecha de firma, si aplica.
  signedAt DateTime?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter      Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authoredByUser User?     @relation(fields: [authoredByUserId], references: [id], onDelete: SetNull)
  emergencyEvolution EmergencyEvolution?
  emergencyOrderSet EmergencyOrderSet?
  emergencyDischarge EmergencyDischarge?
  emergencyDocument EmergencyDocument?
  emergencyConsultation EmergencyConsultation?
  hospitalAdmission HospitalAdmission?
  hospitalEvolution HospitalEvolution?
  hospitalMedicalOrder HospitalMedicalOrder?
  hospitalConsultation HospitalConsultation?
  hospitalSurgicalDocument HospitalSurgicalDocument?
  hospitalNursingShift HospitalNursingShift?
  hospitalDischarge HospitalDischarge?
  hospitalDocument HospitalDocument?

  @@index([tenantId])
