/// Expediente clínico maestro.
/// Debe ser único por paciente por sede.
model MedicalRecord {
  /// ID del expediente.
  id String @id @default(uuid())

  /// Tenant dueño del expediente.
  tenantId String

  /// Sede donde vive el expediente.
  facilityId String

  /// Paciente dueño del expediente.
  patientId String

  /// Número de expediente único por sede.
  recordNumber String

  /// Estado del expediente.
  status MedicalRecordStatus @default(ACTIVE)

  /// Fecha de apertura.
  openedAt DateTime @default(now())

  /// Último episodio relacionado.
  lastEncounterAt DateTime?

  /// Fecha de archivado.
  archivedAt DateTime?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility          Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounters        Encounter[]
  clinicalDocuments ClinicalDocument[]

  @@unique([facilityId, recordNumber])
  @@unique([facilityId, patientId])
  @@index([tenantId])
  @@index([facilityId])
  @@index([patientId])
}

/// Episodio de atención.
/// Puede ser consulta, urgencias, hospitalización, cirugía, seguimiento, etc.
