/// Consentimiento informado.
model ConsentForm {
  /// ID del consentimiento.
  id String @id @default(uuid())

  /// Tenant dueño del dato.
  tenantId String

  /// Sede relacionada.
  facilityId String

  /// Paciente relacionado.
  patientId String

  /// Episodio relacionado.
  encounterId String?

  /// Documento clínico relacionado.
  clinicalDocumentId String?

  /// Título visible.
  title String

  /// Acto autorizado.
  authorizedAct String

  /// Riesgos y beneficios.
  risksBenefits String?

  /// Indica si fue autorización en contexto de urgencia.
  emergencyAuthorization Boolean @default(false)

  /// Nombre de quien otorga el consentimiento.
  grantedByName String

  /// Relación con el paciente.
  grantedByRelation String?

  /// Fecha/hora de otorgamiento.
  grantedAt DateTime

  /// Testigo 1.
  witness1Name String?

  /// Testigo 2.
  witness2Name String?

  /// Médico relacionado.
  physicianName String?

  /// Notas adicionales.
  notes String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility         Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter        Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  clinicalDocument ClinicalDocument? @relation(fields: [clinicalDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([clinicalDocumentId])
}

