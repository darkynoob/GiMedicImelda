  clinicalSummary String?

  /// Problemas pendientes.
  pendingProblems String?

  /// Plan terapéutico.
  treatmentPlan String?

  /// Indicaciones ambulatorias.
  ambulatoryRecommendations String?

  /// Pronóstico.
  prognosis String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

