generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

/// Estado general del tenant/cliente del sistema.
enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Estado del usuario.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

/// Tipo de establecimiento o sede.
enum FacilityType {
  HOSPITAL
  CLINIC
  CONSULTING_ROOM
  LABORATORY
  IMAGING_CENTER
  OTHER
}

/// Estado del expediente clínico.
enum MedicalRecordStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

/// Tipo de episodio de atención.
enum EncounterType {
  OUTPATIENT
  EMERGENCY
  HOSPITALIZATION
  SURGERY
  FOLLOW_UP
}

/// Estado del episodio.
enum EncounterStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Categoría funcional del documento.
/// Esto NO es la especialidad.
/// La especialidad va en Specialty.
enum DocumentCategory {
  CONSULTATION
  EMERGENCY
  HOSPITALIZATION
  SURGERY
  NURSING
  DIAGNOSTIC
  LEGAL
  DISCHARGE
  DEATH
  ADMINISTRATIVE
  OTHER
}

/// Estado documental.
enum DocumentStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SIGNED
  AMENDED
  SUPERSEDED
  VOID_ADMIN
}

/// Tipo de firma aplicada.
enum SignatureType {
  SIMPLE_ELECTRONIC
  ADVANCED_ELECTRONIC
  DIGITAL
}

/// Acción auditada.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  EXPORT
  PRINT
  SIGN
  LOGIN
  LOGOUT
  ACCESS_DENIED
}

/// Origen del ingreso.
enum AdmissionSource {
  CONSULTATION
  EMERGENCY
  TRANSFER
  SURGERY
  OTHER
}

/// Tipo de egreso.
enum DischargeType {
  NORMAL
  VOLUNTARY
  TRANSFER
  DEFUNCTION
  OTHER
}

/// Sexo biológico al nacer.
enum SexAtBirth {
  MALE
  FEMALE
  INTERSEX
  UNKNOWN
}

//////////////////////////////////////////////////////
// CORE MULTI-TENANT
//////////////////////////////////////////////////////

/// Cliente dueño del sistema.
/// Ejemplo:
/// - un hospital privado
/// - una cadena de clínicas
/// - un grupo médico
model Tenant {
  /// ID único del tenant.
  id String @id @default(uuid())

  /// Código único del tenant.
  code String @unique

  /// Nombre comercial del tenant.
  name String

  /// Razón social.
  legalName String?

  /// RFC o identificador fiscal.
  taxId String?

  /// Zona horaria principal.
  timezone String @default("America/Mexico_City")

  /// Estado del tenant.
  status TenantStatus @default(ACTIVE)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de última actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  specialties          Specialty[]
  facilities           Facility[]
  users                User[]
  patients             Patient[]
  patientIdentifiers   PatientIdentifier[]
  medicalRecords       MedicalRecord[]
  encounters           Encounter[]
  documentTypes        DocumentType[]
  clinicalDocuments    ClinicalDocument[]
  serviceAreas         ServiceArea[]
  vitalSigns           VitalSign[]
  diagnoses            Diagnosis[]
  problems             Problem[]
  allergies            Allergy[]
  medicationStatements MedicationStatement[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  labResults           LabResult[]
  imagingRequests      ImagingRequest[]
  imagingReports       ImagingReport[]
  nursingNotes         NursingNote[]
  consentForms         ConsentForm[]
  discharges           Discharge[]
  mpNotifications      MpNotification[]
  deathRecords         DeathRecord[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
}

/// Catálogo de especialidades clínicas.
/// Aquí entran ONCO, GASTRO, CARDIO, PEDI, GINE, etc.
model Specialty {
  /// ID único de la especialidad.
  id String @id @default(uuid())

  /// Tenant dueño del catálogo.
  tenantId String

  /// Código corto único.
  /// Ejemplo: ONCO, GASTRO, CARDIO.
  code String

  /// Nombre visible de la especialidad.
  /// Ejemplo: Oncología, Gastroenterología.
  name String

  /// Descripción opcional.
  description String?

  /// Activa o inactiva.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  serviceAreas      ServiceArea[]
  encounters        Encounter[]
  documentTypes     DocumentType[]
  clinicalDocuments ClinicalDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([name])
}

/// Sede física del tenant.
/// Ejemplo:
/// - Hospital Central
/// - Clínica Roma
/// - Consultorio 2
model Facility {
  /// ID único de la sede.
  id String @id @default(uuid())

  /// Tenant dueño de la sede.
  tenantId String

  /// Código único dentro del tenant.
  code String

  /// Nombre visible de la sede.
  name String

  /// Razón social de la sede.
  legalName String?

  /// Tipo de establecimiento.
  facilityType FacilityType

  /// Nombre de institución, si aplica.
  institutionName String?

  /// Propietario o responsable.
  ownerName String?

  /// Dirección principal.
  addressLine1 String

  /// Complemento de dirección.
  addressLine2 String?

  /// Ciudad.
  city String?

  /// Estado.
  state String?

  /// Código postal.
  postalCode String?

  /// País.
  country String @default("MX")

  /// Teléfono principal.
  phone String?

  /// Correo principal.
  email String?

  /// Bandera de activación.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceAreas      ServiceArea[]
  users             User[]
  medicalRecords    MedicalRecord[]
  encounters        Encounter[]
  clinicalDocuments ClinicalDocument[]
  consentForms      ConsentForm[]
  auditLogs         AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Área funcional de una sede.
/// Ejemplo:
/// - Urgencias
/// - Hospitalización
/// - Consulta externa
/// - Quirófano
model ServiceArea {
  /// ID único del área.
  id String @id @default(uuid())

  /// Tenant dueño del área.
  tenantId String

  /// Sede donde existe el área.
  facilityId String

  /// Especialidad predominante del área, si aplica.
  /// Ejemplo: Oncología, Gastro.
  specialtyId String?

  /// Código único del área dentro de la sede.
  code String

  /// Nombre del área.
  name String

  /// Descripción opcional.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  specialty  Specialty?  @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  encounters Encounter[]

  @@unique([facilityId, code])
  @@index([tenantId])
  @@index([facilityId])
  @@index([specialtyId])
}

//////////////////////////////////////////////////////
// AUTH / ACCESS CONTROL
//////////////////////////////////////////////////////

/// Usuario autenticable del sistema.
/// Puede ser médico, enfermería, recepción, admin, etc.
model User {
  /// ID único del usuario.
  id String @id @default(uuid())

  /// Tenant al que pertenece.
  tenantId String

  /// Sede principal asociada.
  facilityId String?

  /// Especialidad principal del usuario.
  /// Ejemplo: un gastroenterólogo o un oncólogo.
  specialtyId String?

  /// Correo para login.
  email String

  /// Hash de contraseña.
  passwordHash String

  /// Nombre.
  firstName String

  /// Primer apellido.
  lastName String

  /// Segundo apellido.
  middleName String?

  /// Nombre completo precalculado.
  fullName String

  /// Cédula profesional o licencia.
  professionalLicense String?

  /// Estado del usuario.
  status UserStatus @default(ACTIVE)

  /// Último login.
  lastLoginAt DateTime?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility             Facility?               @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  specialty            Specialty?              @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  roles                UserRole[]
  authoredDocuments    ClinicalDocument[]      @relation("DocumentAuthor")
  documentVersions     DocumentVersion[]
  documentSignatures   DocumentSignature[]
  statusHistoryChanges DocumentStatusHistory[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  imagingRequests      ImagingRequest[]
  nursingNotes         NursingNote[]
  uploadedAttachments  Attachment[]
  auditLogs            AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([facilityId])
  @@index([specialtyId])
}

/// Rol del sistema.
/// Ejemplo:
/// - PHYSICIAN
/// - NURSE
/// - TENANT_ADMIN
model Role {
  /// ID del rol.
  id String @id @default(uuid())

  /// Código único.
  code String @unique

  /// Nombre visible.
  name String

  /// Descripción.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  permissions RolePermission[]
  users       UserRole[]
}

/// Permiso atómico.
/// Ejemplo:
/// - patients.read
/// - documents.sign
/// - audits.read
model Permission {
  /// ID del permiso.
  id String @id @default(uuid())

  /// Código único del permiso.
  code String @unique

  /// Nombre visible.
  name String

  /// Descripción funcional.
  description String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  roles RolePermission[]
}

/// Tabla pivote usuario-rol.
model UserRole {
  /// ID del vínculo.
  id String @id @default(uuid())

  /// Usuario.
  userId String

  /// Rol.
  roleId String

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// Tabla pivote rol-permiso.
model RolePermission {
  /// ID del vínculo.
  id String @id @default(uuid())

  /// Rol.
  roleId String

  /// Permiso.
  permissionId String

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

//////////////////////////////////////////////////////
// PATIENTS
//////////////////////////////////////////////////////

/// Paciente del sistema.
/// Pertenece al tenant y puede tener expediente en una o varias sedes.
model Patient {
  /// ID único del paciente.
  id String @id @default(uuid())

  /// Tenant dueño del paciente.
  tenantId String

  /// Código externo o legado.
  externalCode String?

  /// Nombre.
  firstName String

  /// Primer apellido.
  lastName String

  /// Segundo apellido.
  middleName String?

  /// Nombre completo precalculado.
  fullName String

  /// Sexo biológico al nacer.
  sexAtBirth SexAtBirth

  /// Fecha de nacimiento.
  birthDate DateTime? @db.Date

  /// Edad snapshot, útil cuando fue capturada textualmente.
  ageSnapshot Int?

  /// Estado civil.
  maritalStatus String?

  /// Tipo sanguíneo.
  bloodType String?

  /// CURP.
  curp String?

  /// Teléfono.
  phone String?

  /// Teléfono alterno.
  alternatePhone String?

  /// Correo.
  email String?

  /// Dirección línea 1.
  addressLine1 String?

  /// Dirección línea 2.
  addressLine2 String?

  /// Ciudad.
  city String?

  /// Estado.
  state String?

  /// Código postal.
  postalCode String?

  /// País.
  country String? @default("MX")

  /// Municipio o alcaldía.
  municipality String?

  /// Colonia.
  neighborhood String?

  /// Calle.
  street String?

  /// Número exterior.
  exteriorNumber String?

  /// Número interior.
  interiorNumber String?

  /// Contacto de emergencia.
  emergencyContactName String?

  /// Teléfono de emergencia.
  emergencyContactPhone String?

  /// Relación con el contacto de emergencia.
  emergencyContactRelation String?

  /// Estatus administrativo del paciente.
  patientStatus String @default("Activo")

  /// Tipo operativo del paciente.
  patientType String?

  /// Unidad médica de referencia capturada en admisión.
  medicalUnit String?

  /// Señala si se confirmaron alergias conocidas al alta.
  hasKnownAllergies Boolean?

  /// Resumen administrativo de alergias conocidas.
  allergiesNotes String?

  /// Ocupación referida.
  occupation String?

  /// Escolaridad referida.
  educationLevel String?

  /// Religión referida.
  religion String?

  /// Lengua principal del paciente.
  primaryLanguage String?

  /// Si requiere traductor para la atención.
  requiresTranslator Boolean?

  /// Origen o canal del registro.
  registrationSource String?

  /// Observaciones administrativas del alta.
  administrativeNotes String?

  /// Activo/inactivo lógico.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifiers          PatientIdentifier[]
  medicalRecords       MedicalRecord[]
  encounters           Encounter[]
  vitalSigns           VitalSign[]
  diagnoses            Diagnosis[]
  problems             Problem[]
  allergies            Allergy[]
  medicationStatements MedicationStatement[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  labResults           LabResult[]
  imagingRequests      ImagingRequest[]
  imagingReports       ImagingReport[]
  nursingNotes         NursingNote[]
  consentForms         ConsentForm[]
  discharges           Discharge[]
  mpNotifications      MpNotification[]
  deathRecords         DeathRecord[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
  clinicalDocuments    ClinicalDocument[]

  @@index([tenantId])
  @@index([fullName])
  @@index([curp])
  @@index([phone])
  @@index([externalCode])
}

/// Identificadores alternos del paciente.
/// Ejemplo:
/// - NSS
/// - póliza
/// - número legado
model PatientIdentifier {
  /// ID del identificador.
  id String @id @default(uuid())

  /// Tenant dueño del registro.
  tenantId String

  /// Paciente dueño del identificador.
  patientId String

  /// Tipo de identificador.
  identifierType String

  /// Valor del identificador.
  identifierValue String

  /// Indica si es principal.
  isPrimary Boolean @default(false)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, identifierType, identifierValue])
  @@index([tenantId])
  @@index([patientId])
}

//////////////////////////////////////////////////////
// MEDICAL RECORD / ENCOUNTERS
//////////////////////////////////////////////////////

/// Expediente clínico maestro.
/// Debe ser único por paciente por sede.
model MedicalRecord {
  /// ID del expediente.
  id String @id @default(uuid())

  /// Tenant dueño del expediente.
  tenantId String

  /// Sede donde vive el expediente.
  facilityId String

  /// Paciente dueño del expediente.
  patientId String

  /// Número de expediente único por sede.
  recordNumber String

  /// Estado del expediente.
  status MedicalRecordStatus @default(ACTIVE)

  /// Fecha de apertura.
  openedAt DateTime @default(now())

  /// Último episodio relacionado.
  lastEncounterAt DateTime?

  /// Fecha de archivado.
  archivedAt DateTime?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility          Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounters        Encounter[]
  clinicalDocuments ClinicalDocument[]

  @@unique([facilityId, recordNumber])
  @@unique([facilityId, patientId])
  @@index([tenantId])
  @@index([facilityId])
  @@index([patientId])
}

/// Episodio de atención.
/// Puede ser consulta, urgencias, hospitalización, cirugía, seguimiento, etc.
model Encounter {
  /// ID del episodio.
  id String @id @default(uuid())

  /// Tenant dueño del episodio.
  tenantId String

  /// Sede donde ocurrió.
  facilityId String

  /// Área funcional.
  serviceAreaId String?

  /// Especialidad bajo la cual se atendió.
  specialtyId String?

  /// Expediente clínico.
  medicalRecordId String

  /// Paciente atendido.
  patientId String

  /// Número único del episodio por sede.
  encounterNumber String

  /// Tipo de episodio.
  encounterType EncounterType

  /// Estado del episodio.
  status EncounterStatus @default(OPEN)

  /// Origen del ingreso.
  admissionSource AdmissionSource?

  /// Fecha/hora de apertura.
  openedAt DateTime @default(now())

  /// Fecha/hora de cierre.
  closedAt DateTime?

  /// Usuario tratante/responsable principal.
  attendingUserId String?

  /// Motivo de consulta/ingreso.
  reasonForVisit String?

  /// Notas generales.
  notes String?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility             Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  serviceArea          ServiceArea?          @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  specialty            Specialty?            @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  medicalRecord        MedicalRecord         @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicalDocuments    ClinicalDocument[]
  vitalSigns           VitalSign[]
  diagnoses            Diagnosis[]
  problems             Problem[]
  allergies            Allergy[]
  medicationStatements MedicationStatement[]
  procedureRecords     ProcedureRecord[]
  labRequests          LabRequest[]
  labResults           LabResult[]
  imagingRequests      ImagingRequest[]
  imagingReports       ImagingReport[]
  nursingNotes         NursingNote[]
  consentForms         ConsentForm[]
  discharges           Discharge[]
  mpNotifications      MpNotification[]
  deathRecords         DeathRecord[]
  attachments          Attachment[]
  auditLogs            AuditLog[]

  @@unique([facilityId, encounterNumber])
  @@index([tenantId])
  @@index([facilityId])
  @@index([serviceAreaId])
  @@index([specialtyId])
  @@index([medicalRecordId])
  @@index([patientId])
}

//////////////////////////////////////////////////////
// DOCUMENTS / VERSIONING / SIGNATURES
//////////////////////////////////////////////////////

/// Catálogo de tipos documentales.
/// Aquí vive la definición funcional del documento.
model DocumentType {
  /// ID del tipo documental.
  id String @id @default(uuid())

  /// Tenant dueño del catálogo.
  tenantId String

  /// Especialidad a la que aplica, si es específica.
  /// Ejemplo: una nota o formato sólo para oncología.
  specialtyId String?

  /// Código único del tipo documental.
  code String

  /// Nombre visible del tipo documental.
  name String

  /// Categoría funcional.
  category DocumentCategory

  /// Descripción.
  description String?

  /// Si requiere firma para finalizar.
  requiresSignature Boolean @default(true)

  /// Si se puede repetir múltiples veces.
  allowsMultiple Boolean @default(true)

  /// Esquema JSON opcional para validación dinámica.
  schemaJson Json?

  /// Activo/inactivo.
  isActive Boolean @default(true)

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialty         Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  clinicalDocuments ClinicalDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([specialtyId])
  @@index([category])
}

/// Documento clínico maestro.
/// El contenido editable real vive en DocumentVersion.
model ClinicalDocument {
  /// ID del documento.
  id String @id @default(uuid())

  /// Tenant dueño del documento.
  tenantId String

  /// Sede donde existe.
  facilityId String

  /// Expediente al que pertenece.
  medicalRecordId String

  /// Episodio asociado, si aplica.
  encounterId String?

  /// Paciente relacionado.
  patientId String

  /// Tipo documental.
  documentTypeId String

  /// Especialidad clínica del documento, si aplica.
  specialtyId String?

  /// Usuario autor principal.
  authorUserId String

  /// Título visible.
  title String

  /// Estado del documento.
  status DocumentStatus @default(DRAFT)

  /// Fecha clínica del documento.
  documentDate DateTime

  /// Fecha/hora de firma.
  signedAt DateTime?

  /// Fecha/hora de bloqueo.
  lockedAt DateTime?

  /// Versión vigente.
  currentVersionId String? @unique

  /// Metadatos adicionales.
  metadataJson Json?

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Fecha de actualización.
  updatedAt DateTime @updatedAt

  /// Relaciones.
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility      Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  encounter     Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentType  DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  specialty     Specialty?    @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  author        User          @relation("DocumentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  /// Relación a todas las versiones históricas.
  versions DocumentVersion[] @relation("DocumentVersions")

  /// Relación a la versión actual.
  currentVersion DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  /// Firmas del documento.
  signatures DocumentSignature[]

  /// Historial de cambios de estado.
  statusHistory DocumentStatusHistory[]

  /// Adjuntos del documento.
  attachments Attachment[]

  /// Consentimientos ligados a este documento.
  consentForms ConsentForm[]

  @@index([tenantId])
  @@index([facilityId])
  @@index([medicalRecordId])
  @@index([encounterId])
  @@index([patientId])
  @@index([documentTypeId])
  @@index([specialtyId])
  @@index([authorUserId])
  @@index([status])
  @@index([documentDate])
}

/// Snapshot inmutable del contenido del documento.
model DocumentVersion {
  /// ID de la versión.
  id String @id @default(uuid())

  /// Documento al que pertenece.
  documentId String

  /// Número incremental de versión.
  versionNumber Int

  /// Contenido estructurado de la versión.
  contentJson Json

  /// Texto narrativo libre.
  narrativeText String?

  /// Hash SHA-256 del contenido.
  hashSha256 String

  /// Usuario que creó la versión.
  createdByUserId String

  /// Fecha de creación.
  createdAt DateTime @default(now())

  /// Relaciones.
  document           ClinicalDocument  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  createdByUser      User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentForDocument ClinicalDocument? @relation("CurrentDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([createdByUserId])
}

/// Firma aplicada a un documento.
model DocumentSignature {
  /// ID de la firma.
  id String @id @default(uuid())

  /// Documento firmado.
  documentId String

  /// Usuario firmante.
  userId String

  /// Tipo de firma.
  signatureType SignatureType

  /// Hash del contenido firmado.
  signedHash String

  /// Fecha/hora de firma.
  signedAt DateTime @default(now())

  /// Metadatos técnicos de firma.
  metadataJson Json?

  /// Relaciones.
  document ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([userId])
  @@index([signedAt])
}

/// Historial de estados del documento.
model DocumentStatusHistory {
  /// ID del cambio de estado.
  id String @id @default(uuid())

  /// Documento afectado.
  documentId String

  /// Estado anterior.
  fromStatus DocumentStatus?

  /// Estado nuevo.
  toStatus DocumentStatus

  /// Usuario que cambió el estado.
  changedByUserId String

  /// Motivo del cambio.
  reason String?

  /// Fecha del cambio.
  createdAt DateTime @default(now())

  /// Relaciones.
  document      ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedByUser User             @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([changedByUserId])
  @@index([createdAt])
}

