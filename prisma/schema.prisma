  hospitalEvolutionResults HospitalEvolutionResult[]
  hospitalEvolutionDiagnoses HospitalEvolutionDiagnosis[]
  hospitalMedicalOrders HospitalMedicalOrder[]
  hospitalOrderMedications HospitalOrderMedication[]
  hospitalOrderSolutions HospitalOrderIntravenousSolution[]
  hospitalOrderStudies HospitalOrderRequestedStudy[]
  hospitalOrderConsultations HospitalOrderConsultationRequest[]
  hospitalOrderTraces HospitalOrderTrace[]
  hospitalConsultations HospitalConsultation[]
  hospitalSurgicalDocuments HospitalSurgicalDocument[]
  hospitalNursingShifts HospitalNursingShift[]
  hospitalNursingVitals HospitalNursingVitalSign[]
  hospitalMedicationAdministrations HospitalMedicationAdministration[]
  hospitalNursingProcedures HospitalNursingProcedure[]
